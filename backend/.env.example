# Desarrollo local: reemplazar todos los valores de ejemplo antes de iniciar.
NODE_ENV=development
PORT=3004
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/torneos_pesca?schema=public"
JWT_SECRET="generate-a-long-random-secret-for-local-development"
JWT_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:3005
ALLOW_BOOTSTRAP_ADMIN=false
CORS_ALLOWED_ORIGINS=http://localhost:3005
TRUST_PROXY_HEADERS=false
MEDIA_STORAGE_DIR=./uploads

# Opcional: habilita el envío de correos transaccionales.
RESEND_API_KEY=
EMAIL_FROM=
